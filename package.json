{
  "name": "@open-core/ragemp-adapter",
  "version": "1.0.3",
  "description": "External Rage Multiplayer adapter for OpenCore framework.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/newcore-network/opencore-ragemp-adapter"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p src/shared/tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit && tsc -p src/server/tsconfig.json --noEmit",
    "build:shared": "tsc -b src/shared",
    "build:client": "tsc -b src/client",
    "build:server": "tsc -b src/server",
    "check": "pnpx @biomejs/biome check .",
    "check:fix": "pnpx @biomejs/biome check --write .",
    "format": "biome format --fix",
    "validate": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "opencore",
    "ragemp",
    "rage-mp",
    "adapter"
  ],
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.13.1",
  "peerDependencies": {
    "@open-core/framework": "^1.0.11",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@open-core/framework": "^1.0.12",
    "@ragempcommunity/types-client": "^2.1.9",
    "@ragempcommunity/types-server": "^2.1.9",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
